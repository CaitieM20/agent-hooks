{
  "description": "Illustrative example instances for the existing flat pre_tool_call request and bare in-process Verdict contract. The request and bare verdict examples are validated against the checked-in schemas; this file is example data, not a JSON Schema definition. Hosted interceptor-response transport separately accepts bare verdicts or a {verdict, extensions?} envelope under §5.5.",
  "scenario": {
    "tool_call": {
      "id": "call-42",
      "name": "read_file",
      "args": {
        "path": "src/config.json",
        "dry_run": true
      }
    },
    "replacement_args": {
      "path": "src/config.json",
      "dry_run": false,
      "format": "json"
    }
  },
  "request": {
    "spec": "agent-hooks/0.1",
    "interception_point": "pre_tool_call",
    "timestamp": "2026-10-30T12:00:00Z",
    "sequence": 7,
    "agent": {
      "id": "agent-42",
      "framework": "copilot"
    },
    "session": {
      "id": "session-17"
    },
    "tool_call": {
      "id": "call-42",
      "name": "read_file",
      "args": {
        "path": "src/config.json",
        "dry_run": true
      }
    },
    "target": {
      "path": "src/config.json",
      "dry_run": true
    }
  },
  "responses": {
